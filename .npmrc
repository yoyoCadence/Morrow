# Supply-chain guardrails (see docs/plans/active-plan.md, threat model).
# Dependencies may not run install scripts.
ignore-scripts=true
# Pin exact versions; the lockfile is the source of truth.
save-exact=true
# Refuse to install on the wrong Node major.
engine-strict=true
# Do not resolve to a version published less than 7 days ago.
min-release-age=7
fund=false
