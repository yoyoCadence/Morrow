# Copy to .env and fill in. Never commit .env.
# scripts\pg-local.ps1 init writes the two database URLs for you.

# OFF | RESEARCH | PAPER. Any other value, including every live mode, is
# refused at startup. OFF does not contact data providers.
MORROW_MODE=OFF

MORROW_DATABASE_URL=postgres://morrow:CHANGE_ME@127.0.0.1:54317/morrow
# Used only by "npm test". The database name must end in _test.
MORROW_TEST_DATABASE_URL=postgres://morrow:CHANGE_ME@127.0.0.1:54317/morrow_test

# MORROW_API_PORT=8787
# MORROW_LOG_LEVEL=info

# Read-only data API credentials from each provider's free tier. Leave empty
# until you have them. None of these is a wallet key; this build has no place
# for one and rejects any MORROW_* setting it does not recognise.
MORROW_JUPITER_API_KEY=
MORROW_HELIUS_API_KEY=
MORROW_OKX_API_KEY=
MORROW_OKX_SECRET_KEY=
MORROW_OKX_PASSPHRASE=
